# Paste your MongoDB connection string when ready (Atlas or local).
# Leave empty / unset to use an in-memory MongoDB for local testing.
# Required on Vercel (Production/Preview) — never commit real values.
MONGODB_URI=

# Optional API port (default 8787)
PORT=8787

# Single-user login (env-only — do not put real passwords in source).
# Aliases AUTH_EMAIL / AUTH_PASSWORD also work.
DESKLY_USER=
DESKLY_PASSWORD=

# Signs the httpOnly session cookie. Generate a long random string.
# Required for login (local + Vercel).
SESSION_SECRET=
